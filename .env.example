# Hospital CRM Environment Configuration
# ======================================
# Copy this file to .env and fill in your values

# Database (MongoDB)
DATABASE_URL="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/hospitalcrm?retryWrites=true&w=majority"

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Gemini AI API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
